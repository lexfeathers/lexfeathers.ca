{{# Theme toggle button by Óscar Otero #}}
<button
  id="theme-selector"
  class="theme-selector-button"
  aria-pressed="false"
  title="Change theme"
>
  <span aria-hidden="true" class="icon">
    <div class="theme-selector-icon icon icon-contrast"></div>
  </span>
</button>

<style>
  /* Theme selector button basic styling */
  :root {
    .theme-selector-icon {
      -webkit-mask: var(--icon-desktop) no-repeat center / contain;
      mask: var(--icon-desktop) no-repeat center / contain; 
    }
  }
  :root[data-theme="dark"] {
    .theme-selector-icon {
      -webkit-mask: var(--icon-moon) no-repeat center / contain;
      mask: var(--icon-moon) no-repeat center / contain;    
    }
  }
  :root[data-theme="light"] {
    .theme-selector-icon {
      -webkit-mask: var(--icon-sun) no-repeat center / contain;
      mask: var(--icon-sun) no-repeat center / contain;    
    }
  }

  :root.no-js {
    #theme-selector {
      display: none;
    }
  }

  #theme-selector {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0px;

    &[aria-pressed="true"] .icon {
      rotate: 180deg;
    }

    & .icon {
      width: 2rem;
      height: 2rem;
      transition: ease-out 400ms;

      & .theme-selector-icon {
        background-color: var(--color-secondary);
        margin: 0; /* Remove any margins so it spins cleanly */
      }
    }
  }
</style>

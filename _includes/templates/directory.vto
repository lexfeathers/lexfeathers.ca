---
layout: /layout.vto
title: directory of posts
order: 3
---
<div data-pagefind-ignore="data-pagefind-ignore">
    <div class="post-directory">
        {{ include "partials/pagination.vto" }}

        <ul class="directory">
            {{ for post of results }}
                {{ include "partials/directory-card.vto" { post } }}
            {{ /for }}
        </ul>
        
        {{ include "partials/pagination.vto" }}
    </div>
</div>
